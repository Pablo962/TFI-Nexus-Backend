generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_HR
  MANAGER
  EMPLOYEE
  RECRUITER
}

enum RiskStatus {
  optimal
  moderate
  spof
}

enum JobStatus {
  critical
  operational
}

// =======================================================================
// BLOQUE 1: GESTIÓN DE CAPITAL HUMANO Y TALENTO (6 TABLAS)
// =======================================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  employeeId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model JobPosition {
  id                    String      @id @default(uuid())
  code                  String      @unique
  title                 String
  department            String
  status                JobStatus   @default(operational)
  activeIncumbentsCount Int         @default(1)
  complianceRate        Float       @default(100)
  division              String
  reportsTo             String
  supervises            String
  salaryBand            String
  mission               String
  purposeLink           String?
  internalRelations     String?
  externalRelations     String?
  formalAuthority       String?
  workingConditions     Json?
  responsibilities      Json?
  techSkills            Json?
  softSkills            Json?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  employees             Employee[]
  vacantes              Vacante[]

  @@map("job_positions")
}

model Employee {
  id                  String       @id
  empId               String       @unique
  name                String
  email               String       @unique
  phone               String?
  role                String
  area                String
  tenure              String
  contract            String
  location            String
  salaryBand          String
  percentile          String
  avatar              String
  supervisorName      String
  supervisorRole      String
  supervisorAvatar    String
  roleMatch           Float        @default(90)
  gFactor             Float        @default(1.0)
  status              String       @default("Óptimo")
  badge               String       @default("Referente Técnico")
  criticality         Float        @default(8.5)
  riskStatus          RiskStatus   @default(optimal)
  spectrumSkills      Json?
  hardSkills          Json?
  softSkills          Json?
  recommendedTraining Json?
  reviews             Json?
  projects            Json?

  jobPositionId       String?
  jobPosition         JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  evaluations         Evaluation[]

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("employees")
}

model Evaluation {
  id               String   @id @default(uuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName     String
  role             String
  area             String
  cycle            String   @default("Ciclo Anual 2026")
  performanceScore Float
  potentialScore   Float
  box9             String
  status           String   @default("Pendiente")
  selfScore        Float
  managerScore     Float
  peersScore       Float
  calibratedScore  Float
  gapAnalysis      String

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("evaluations")
}

model LearningTrack {
  id                String   @id
  title             String
  category          String?
  duration          String?
  provider          String?
  level             String?
  cost              String?
  enrolledCount     Int      @default(0)
  status            String?  @default("En curso")
  skillsCovered     Json?
  modules           Json?
  enrolledEmployees Json?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("learning_tracks")
}

model PorterActivity {
  id             Int      @id
  step           String
  name           String
  subname        String
  layer          String   @default("primary")
  coverage       Float    @default(90)
  coverageStatus String   @default("optimal")
  headcount      Int      @default(10)
  costEfficiency String   @default("95% Óptimo")
  strategicNotes String?
  rolesList      Json?
  topTalent      Json?
  skillsMatrix   Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("porter_activities")
}

// =======================================================================
// BLOQUE 2: MODELO RELACIONAL DE RECLUTAMIENTO Y SELECCIÓN (6 TABLAS)
// =======================================================================

model Vacante {
  id                 Int                 @id @default(autoincrement()) @map("identificador")
  idPuesto           String?             @map("id_puesto")
  puesto             JobPosition?        @relation(fields: [idPuesto], references: [id], onDelete: SetNull)
  titulo             String              @map("titulo") @db.VarChar
  requisitos         String?             @map("requisitos") @db.VarChar
  tipo               String?             @map("tipo") @db.VarChar

  postulaciones      Postulacion[]
  vacanteHabilidades VacanteHabilidad[]

  @@map("vacante")
}

model Perfil {
  id              Int                 @id @default(autoincrement()) @map("identificador")
  nombre          String              @map("nombre") @db.VarChar
  apellido        String              @map("apellido") @db.VarChar
  dni             String?             @map("dni") @db.VarChar
  fechaNacimiento DateTime?           @map("fecha_nacimiento") @db.Date
  direccion       String?             @map("direccion") @db.VarChar
  telefono        String?             @map("telefono") @db.VarChar
  correo          String              @map("correo") @db.VarChar
  carrera         String?             @map("carrera") @db.VarChar
  anioCursado     String?             @map("anio_cursado") @db.VarChar
  legajo          String?             @map("legajo") @db.VarChar
  descripcion     String?             @map("descripcion") @db.VarChar
  area            String?             @map("area") @db.VarChar
  requisitos      String?             @map("requisitos") @db.VarChar
  beneficios      String?             @map("beneficios") @db.VarChar
  perfilAsignado  String?             @map("perfil_asignado") @db.VarChar
  justificacion   String?             @map("justificacion") @db.VarChar

  postulaciones   Postulacion[]
  habilidades     PerfilHabilidad[]

  @@map("perfil")
}

model Habilidad {
  id                 Int                 @id @default(autoincrement()) @map("identificador")
  nombre             String              @map("nombre") @db.VarChar
  tipo               String?             @map("tipo") @db.VarChar

  vacanteHabilidades VacanteHabilidad[]
  perfilHabilidades  PerfilHabilidad[]

  @@map("habilidad")
}

model Postulacion {
  perfilId      Int     @map("perfil_id")
  vacanteId     Int     @map("vacante_id")
  ranking       Int?    @map("ranking")
  justificacion String? @map("justificacion") @db.VarChar

  perfil        Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  vacante       Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  @@id([perfilId, vacanteId])
  @@map("postulacion")
}

model VacanteHabilidad {
  vacanteId   Int       @map("vacante_id")
  habilidadId Int       @map("habilidad_id")

  vacante     Vacante   @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  habilidad   Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade)

  @@id([vacanteId, habilidadId])
  @@map("vacante_habilidad")
}

model PerfilHabilidad {
  perfilId    Int       @map("perfil_id")
  habilidadId Int       @map("habilidad_id")

  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  habilidad   Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade)

  @@id([perfilId, habilidadId])
  @@map("perfil_habilidad")
}
