generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN_HR
  MANAGER
  EMPLOYEE
  RECRUITER
}

enum RiskStatus {
  optimal
  moderate
  spof
}

enum JobStatus {
  critical
  operational
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(EMPLOYEE)
  employeeId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model JobPosition {
  id                    String      @id @default(uuid())
  code                  String      @unique
  title                 String
  department            String
  status                JobStatus   @default(operational)
  activeIncumbentsCount Int         @default(1)
  complianceRate        Float       @default(100)
  division              String
  reportsTo             String
  supervises            String
  salaryBand            String
  mission               String
  purposeLink           String?
  internalRelations     String?
  externalRelations     String?
  formalAuthority       String?
  workingConditions     Json?
  responsibilities      Json?
  techSkills            Json?
  softSkills            Json?

  // Campos específicos del Modelo del Word (Gestión de Capital Humano)
  nPosiciones           Int         @default(1) @map("n_posiciones")
  proposito             String?     @map("proposito")
  idUnidad              String?     @map("id_unidad")
  unidad                Unidad?     @relation(fields: [idUnidad], references: [id], onDelete: SetNull)
  idPuestoSuperior      String?     @map("id_puesto_superior")
  puestoSuperior        JobPosition?  @relation("JerarquiaPuestos", fields: [idPuestoSuperior], references: [id], onDelete: SetNull)
  puestosSubordinados   JobPosition[] @relation("JerarquiaPuestos")

  // Relaciones del Modelo Relacional del Word (12 tablas)
  perfil                Perfil?
  responsabilidadFicha  Responsabilidad?
  funciones             Funcion[]
  condicionesTrabajo    CondicionTrabajo[]
  riesgosPuesto         RiesgoPuesto[]
  relacionesPuesto      RelacionPuesto[]
  estandaresDesempeno   EstandarDesempeno[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  employees             Employee[]
  candidates            Candidate[]
  evaluations           Evaluation[]

  @@map("job_positions")
}

model Employee {
  id                  String       @id
  empId               String       @unique
  name                String
  email               String       @unique
  phone               String?
  role                String
  area                String
  tenure              String
  contract            String
  location            String
  salaryBand          String
  percentile          String
  avatar              String
  supervisorName      String
  supervisorRole      String
  supervisorAvatar    String
  roleMatch           Float        @default(90)
  gFactor             Float        @default(1.0)
  status              String       @default("Óptimo")
  badge               String       @default("Referente Técnico")
  criticality         Float        @default(8.5)
  riskStatus          RiskStatus   @default(optimal)
  spectrumSkills      Json?
  hardSkills          Json?
  softSkills          Json?
  recommendedTraining Json?
  reviews             Json?
  projects            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  jobPositionId       String?
  jobPosition         JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)
  evaluations         Evaluation[]

  @@map("employees")
}

model Candidate {
  id            String       @id @default(uuid())
  rank          Int          @default(1)
  name          String
  title         String
  experience    String
  avatar        String
  matchScore    Int          @default(80)
  matchLabel    String
  techScore     Float
  softScore     Float
  strengths     String
  stage         String       @default("Revisión Inicial")
  notes         String?
  radarScores   Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  jobPositionId String?
  jobPosition   JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  @@map("candidatos")
}

model Evaluation {
  id               String    @id @default(uuid())
  cycle            String    @default("Ciclo Anual 2026")
  employeeName     String
  role             String
  area             String
  avatar           String
  evaluator        String
  selfScore        Float
  managerScore     Float
  peersScore       Float
  calibratedScore  Float
  box9             String
  status           String    @default("Calibrado")
  potentialScore   Float
  performanceScore Float
  gapAnalysis      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  jobPositionId    String?   @map("id_puesto")
  jobPosition      JobPosition? @relation(fields: [jobPositionId], references: [id], onDelete: SetNull)

  @@map("evaluations")
}

// =======================================================================
// MODELO RELACIONAL DE DESCRIPCIÓN Y ESPECIFICACIÓN DE PUESTOS (WORD)
// =======================================================================

model Unidad {
  id               String       @id @default(uuid()) @map("id_unidad")
  nombre           String       @map("nombre")
  idUnidadSuperior String?      @map("id_unidad_superior")
  unidadSuperior   Unidad?      @relation("JerarquiaUnidades", fields: [idUnidadSuperior], references: [id], onDelete: SetNull)
  subunidades      Unidad[]     @relation("JerarquiaUnidades")
  puestos          JobPosition[]

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("unidades")
}

model Funcion {
  id          String      @id @default(uuid()) @map("id_funcion")
  idPuesto    String      @map("id_puesto")
  puesto      JobPosition @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  descripcion String      @map("descripcion")
  tareas      Tarea[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("funciones")
}

model Tarea {
  id          String   @id @default(uuid()) @map("id_tarea")
  idFuncion   String   @map("id_funcion")
  funcion     Funcion  @relation(fields: [idFuncion], references: [id], onDelete: Cascade)
  descripcion String   @map("descripcion")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tareas")
}

model Perfil {
  idPuesto             String              @id @map("id_puesto")
  puesto               JobPosition         @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  educacionFormal      String              @map("educacion_formal")
  experienciaRequerida String              @map("experiencia_requerida")
  perfilCompetencias   PerfilCompetencia[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@map("perfiles")
}

model Competencia {
  id                 String              @id @default(uuid()) @map("id_competencia")
  descripcion        String              @map("descripcion")
  tipo               String              @map("tipo") // "genérica" o "específica"
  perfilCompetencias PerfilCompetencia[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@map("competencias")
}

model PerfilCompetencia {
  idPuesto      String      @map("id_puesto")
  idCompetencia String      @map("id_competencia")
  perfil        Perfil      @relation(fields: [idPuesto], references: [idPuesto], onDelete: Cascade)
  competencia   Competencia @relation(fields: [idCompetencia], references: [id], onDelete: Cascade)

  @@id([idPuesto, idCompetencia])
  @@map("perfil_competencias")
}

model Responsabilidad {
  idPuesto          String      @id @map("id_puesto")
  puesto            JobPosition @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  manejoPersonal    String?     @map("manejo_personal")
  equipoTrabajo     String?     @map("equipo_trabajo")
  manejoInformacion String?     @map("manejo_informacion")

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@map("responsabilidades")
}

model CondicionTrabajo {
  id          String      @id @default(uuid()) @map("id_condicion")
  idPuesto    String      @map("id_puesto")
  puesto      JobPosition @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  descripcion String      @map("descripcion")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("condiciones_trabajo")
}

model RiesgoPuesto {
  id           String      @id @default(uuid()) @map("id_riesgo")
  idPuesto     String      @map("id_puesto")
  puesto       JobPosition @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  tipoRiesgo   String      @map("tipo_riesgo")
  motivo       String      @map("motivo")
  consecuencia String      @map("consecuencia")

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("riesgos_puesto")
}

model RelacionPuesto {
  id                 String      @id @default(uuid()) @map("id_relacion")
  idPuesto           String      @map("id_puesto")
  puesto             JobPosition @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  tipo               String      @map("tipo") // "interna" o "externa"
  puestoOInstitucion String      @map("puesto_o_institucion")
  unidad             String?     @map("unidad")
  proposito          String      @map("proposito")

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@map("relaciones_puesto")
}

model EstandarDesempeno {
  id          String      @id @default(uuid()) @map("id_estandar")
  idPuesto    String      @map("id_puesto")
  puesto      JobPosition @relation(fields: [idPuesto], references: [id], onDelete: Cascade)
  descripcion String      @map("descripcion")

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("estandares_desempeno")
}

