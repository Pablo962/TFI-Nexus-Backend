generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =======================================================================
// MODELO RELACIONAL DE RECLUTAMIENTO Y SELECCIÓN (6 TABLAS DE SUPABASE)
// =======================================================================

model Vacante {
  id                 Int                 @id @default(autoincrement()) @map("identificador")
  titulo             String              @map("titulo") @db.VarChar
  requisitos         String?             @map("requisitos") @db.VarChar
  tipo               String?             @map("tipo") @db.VarChar

  postulaciones      Postulacion[]
  vacanteHabilidades VacanteHabilidad[]

  @@map("vacante")
}

model Perfil {
  id              Int                 @id @default(autoincrement()) @map("identificador")
  nombre          String              @map("nombre") @db.VarChar
  apellido        String              @map("apellido") @db.VarChar
  dni             String?             @map("dni") @db.VarChar
  fechaNacimiento DateTime?           @map("fecha_nacimiento") @db.Date
  direccion       String?             @map("direccion") @db.VarChar
  telefono        String?             @map("telefono") @db.VarChar
  correo          String              @map("correo") @db.VarChar
  carrera         String?             @map("carrera") @db.VarChar
  anioCursado     String?             @map("anio_cursado") @db.VarChar
  legajo          String?             @map("legajo") @db.VarChar
  descripcion     String?             @map("descripcion") @db.VarChar
  area            String?             @map("area") @db.VarChar
  requisitos      String?             @map("requisitos") @db.VarChar
  beneficios      String?             @map("beneficios") @db.VarChar
  perfilAsignado  String?             @map("perfil_asignado") @db.VarChar
  justificacion   String?             @map("justificacion") @db.VarChar

  postulaciones   Postulacion[]
  habilidades     PerfilHabilidad[]

  @@map("perfil")
}

model Habilidad {
  id                 Int                 @id @default(autoincrement()) @map("identificador")
  nombre             String              @map("nombre") @db.VarChar
  tipo               String?             @map("tipo") @db.VarChar

  vacanteHabilidades VacanteHabilidad[]
  perfilHabilidades  PerfilHabilidad[]

  @@map("habilidad")
}

model Postulacion {
  perfilId      Int     @map("perfil_id")
  vacanteId     Int     @map("vacante_id")
  ranking       Int?    @map("ranking")
  justificacion String? @map("justificacion") @db.VarChar

  perfil        Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  vacante       Vacante @relation(fields: [vacanteId], references: [id], onDelete: Cascade)

  @@id([perfilId, vacanteId])
  @@map("postulacion")
}

model VacanteHabilidad {
  vacanteId   Int       @map("vacante_id")
  habilidadId Int       @map("habilidad_id")

  vacante     Vacante   @relation(fields: [vacanteId], references: [id], onDelete: Cascade)
  habilidad   Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade)

  @@id([vacanteId, habilidadId])
  @@map("vacante_habilidad")
}

model PerfilHabilidad {
  perfilId    Int       @map("perfil_id")
  habilidadId Int       @map("habilidad_id")

  perfil      Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  habilidad   Habilidad @relation(fields: [habilidadId], references: [id], onDelete: Cascade)

  @@id([perfilId, habilidadId])
  @@map("perfil_habilidad")
}
